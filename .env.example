# MIRA Supabase configuration
# Copy this file to .env.local and replace the placeholder values.
# Required for browser auth, server-side auth, and database access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: override the public deployment URL used for auth redirect links.
# This is useful in local development and production deployments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: if you are deploying on Vercel and do not set NEXT_PUBLIC_SITE_URL,
# MIRA will automatically fall back to VERCEL_URL / NEXT_PUBLIC_VERCEL_URL.
# NEXT_PUBLIC_VERCEL_URL=your-app.vercel.app
